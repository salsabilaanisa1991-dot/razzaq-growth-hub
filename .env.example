HOST=127.0.0.1
PORT=3080
# Jalankan npm run setup untuk membuat kata sandi acak.
APP_PASSWORD=
DATA_DIR=./data
# Isi URL HTTPS saat di-host di VPS. Tanpa garis miring penutup.
PUBLIC_ORIGIN=
# Jalankan npm run meta:setup untuk mengisi koneksi Meta secara lokal.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
# Koneksi Google Ads; isi lokal dengan npm run google:setup.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v26
