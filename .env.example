HOST=127.0.0.1
PORT=3080
# Jalankan npm run setup untuk membuat kata sandi acak.
APP_PASSWORD=
DATA_DIR=./data
# Isi URL HTTPS saat di-host di VPS. Tanpa garis miring penutup.
PUBLIC_ORIGIN=
